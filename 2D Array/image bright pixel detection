#include <stdio.h>

int main() {
    int r, c;

    printf("Enter the rows and columns:\n");
    scanf("%d %d", &r, &c);

    int arr[r][c];

    printf("Enter the array elements:\n");
    for(int i = 0; i < r; i++) {
        for(int j = 0; j < c; j++) {
            scanf("%d", &arr[i][j]);
        }
    }

    int count = 0;

    for(int i = 0; i < r; i++) {
        for(int j = 0; j < c; j++) {
            if(arr[i][j] > 200) {   // bright pixel condition
                count++;
            }
        }
    }

    printf("%d number of bright pixels we have", count);

    return 0;
}
