#include <stdio.h>

int main() {
    int r, c;
    scanf("%d %d", &r, &c);

    int arr[r][c];
    int count = 0;

    for(int i = 0; i < r; i++) {
        for(int j = 0; j < c; j++) {
            scanf("%d", &arr[i][j]);
        }
    }

    for(int i = 0; i < r; i++) {
        for(int j = 0; j < c; j++) {

            int RowMin = 1;
            int ColMax = 1;

            for(int k = 0; k < c; k++) {
                if(arr[i][k] < arr[i][j]) {
                    RowMin = 0;
                    break;
                }
            }

            for(int k = 0; k < r; k++) {
                if(arr[k][j] > arr[i][j]) {
                    ColMax = 0;
                    break;
                }
            }

            if(RowMin && ColMax)
                count++;
        }
    }

    printf("%d", count);

    return 0;
}
