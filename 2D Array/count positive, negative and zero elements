#include <stdio.h>

int main() {
    int r,c;
    scanf("%d %d",&r,&c);

    int arr[r][c];
    int pos=0, neg=0, zero=0;

    for(int i=0;i<r;i++) {
        for(int j=0;j<c;j++) {
            scanf("%d",&arr[i][j]);

            if(arr[i][j] > 0)
                pos++;
            else if(arr[i][j] < 0)
                neg++;
            else
                zero++;
        }
    }

    printf("Positive = %d\n", pos);
    printf("Negative = %d\n", neg);
    printf("Zero = %d", zero);

    return 0;
}
