#include <stdio.h>

int main() {
    int r, c;

    scanf("%d %d", &r, &c);

    int arr[r][c];

    for(int i = 0; i < r; i++) {
        for(int j = 0; j < c; j++) {
            scanf("%d", &arr[i][j]);
        }
    }

    int maxProduct = arr[0][0] * arr[1][0];

    for(int i = 0; i < r; i++) {
        for(int j = 0; j < c; j++) {

            for(int i = i + 1; i < r; i++) {
                for(int i = 0; i < c; i++) {

                    int product = arr[i][j] * arr[i][j];

                    if(product > maxProduct) {
                        maxProduct = product;
                    }
                }
            }

        }
    }

    printf("%d", maxProduct);

    return 0;
}
