#include <stdio.h>

int main() {
    int n;
    scanf("%d",&n);

    int arr[n][n];
    int flag = 1;

    for(int i=0;i<n;i++)
        for(int j=0;j<n;j++)
            scanf("%d",&arr[i][j]);

    for(int i=0;i<n;i++) {
        for(int j=0;j<n;j++) {
            if(arr[i][j] != arr[j][i]) {
                flag = 0;
                break;
            }
        }
    }

    if(flag)
        printf("Symmetric Matrix");
    else
        printf("Not Symmetric");

    return 0;
}
