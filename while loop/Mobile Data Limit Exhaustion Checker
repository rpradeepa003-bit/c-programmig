#include <stdio.h>

int main()
{
    int totalData, N,usage,i = 0, daysUsed = 0;

    scanf("%d", &totalData);
    scanf("%d", &N);

    while(i < N && totalData > 0)
    {
        scanf("%d", &usage);

        totalData = totalData - usage;
        daysUsed++;

        if(totalData <= 0)
        {
            totalData = 0;
            break;
        }

        i++;
    }

    printf("Days Used: %d\n", daysUsed);
    printf("Remaining Data: %dGB\n", totalData);

    return 0;
}
