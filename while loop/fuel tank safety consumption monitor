#include <stdio.h>

int main() {
    int fuel, N,consumption;
    int i = 0,completedTrips = 0;

    scanf("%d", &fuel);
    scanf("%d", &N);

    while(i < N) {
        scanf("%d", &consumption);

        if(fuel >= consumption) {
            fuel = fuel - consumption;
            completedTrips++;
        } else {

        }

        i++;
    }

    printf("Completed Trips: %d\n", completedTrips);
    printf("Remaining Fuel: %d\n", fuel);

    return 0;
}
