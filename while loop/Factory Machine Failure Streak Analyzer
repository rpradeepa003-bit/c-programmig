#include <stdio.h>

int main()
{
    int N,status, i = 0, currentStreak = 0, longestStreak = 0;

    scanf("%d", &N);

    while(i < N)
    {
        scanf("%d", &status);
        if(status == 0)
        {
            currentStreak++;

            if(currentStreak > longestStreak)
            {
                longestStreak = currentStreak;
            }
        }
        else
        {
            currentStreak = 0;
        }

        i++;
    }
    printf("Longest Failure Streak: %d\n", longestStreak);

    return 0;
}
