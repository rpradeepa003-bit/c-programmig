#include <stdio.h>
#include <string.h>

char secondMostFrequent(char str[]) {
    int freq[256] = {0};
    int i;

    int first = -1, second = -1;
    char firstChar = '\0', secondChar = '\0';

    int n = strlen(str);

    for (i = 0; i < n; i++) {
        freq[(int)str[i]]++;
    }
    for (i = 0; i < 256; i++) {
        if (freq[i] > first) {
            second = first;
            secondChar = firstChar;

            first = freq[i];
            firstChar = (char)i;
        }
        else if (freq[i] > second && freq[i] < first) {
            second = freq[i];
            secondChar = (char)i;
        }
    }
    if (second == -1 && n > 1) {
        return str[1];
    }

    return secondChar;
}

int main() {
    char str[100];

    printf("Enter string: ");
    scanf("%s", str);

    printf("Second most frequent character: %c\n", secondMostFrequent(str));

    return 0;
}
