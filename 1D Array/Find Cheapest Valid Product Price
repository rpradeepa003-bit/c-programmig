#include <stdio.h>
#include <limits.h>

int main() {
    int N;
    scanf("%d", &N);

    int price[N];
    int min = INT_MAX;

    for(int i = 0; i < N; i++) {
        scanf("%d", &price[i]);

        if(price[i] > 0 && price[i] < min) {
            min = price[i];
        }
    }

    if(min == INT_MAX) {
        printf("No valid price");
    } else {
        printf("%d", min);
    }

    return 0;
}
