#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);

    int arr[N];
    int min;

    for(int i = 0; i < N; i++) {
        scanf("%d", &arr[i]);
    }

    min = arr[0];

    for(int i = 1; i < N; i++) {
        if(arr[i] < min) {
            min = arr[i];
        }
    }

    printf("Smallest = %d", min);

    return 0;
}
