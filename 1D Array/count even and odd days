#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);

    int days[N];
    int evenCount = 0, oddCount = 0;

    for(int i = 0; i < N; i++) {
        scanf("%d", &days[i]);

        if(days[i] % 2 == 0)
            evenCount++;
        else
             oddCount++;
    }

    printf("Even:%d Odd:%d", evenCount, oddCount);

    return 0;
}
