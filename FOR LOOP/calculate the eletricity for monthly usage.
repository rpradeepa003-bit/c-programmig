#include <stdio.h>

int main() {
    int N,units, total = 0;

    printf("Enter number of days: ");
    scanf("%d", &N);

    for(int i = 1; i <= N; i++) {
        printf("Enter units for day %d: ", i);
        scanf("%d", &units);

        total = total + units;
    }


    printf("Total Units: %d", total);

    return 0;
}
