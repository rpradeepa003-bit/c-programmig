#include <stdio.h>

void double_increment_example(int num) {
    printf("Input: %d\n", num);
    num++;
    num++;
    printf("Output: %d\n", num);
}

int main() {
    printf("Test Case 1:\n");
    double_increment_example(5); 
    
    printf("\nTest Case 2:\n");
    double_increment_example(0); 
    
    printf("\nTest Case 3:\n");
    double_increment_example(10);
    
    return 0;
}
