#include <stdio.h>

int main() {
    int connectionType;
    int units;
    double billAmount = 0.0;
    double subsidy = 0.0;

    if (scanf("%d %d", &connectionType, &units) != 2) {
        return 1;
    }

    switch (connectionType) {
        case 1: 
            if (units <= 100) {
                billAmount = units * 3.0;
            } else {
                billAmount = (100 * 3.0) + ((units - 100) * 5.0);
            }
            
            subsidy = 80.0;
            billAmount = billAmount - subsidy;

            if (billAmount < 0) billAmount = 0;
            break;

        case 2:
            if (units <= 100) {
                billAmount = units * 7.0;
            } else {
                billAmount = (100 * 7.0) + ((units - 100) * 10.0);
            }
          
            break;

        default:
            printf("Invalid Connection Type\n");
            return 1;
    }

    printf("%d\n", billAmount);

    return 0;
}
