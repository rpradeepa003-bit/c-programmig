#include <stdio.h>

int main() {
    int n , amount,total =0;

    scanf ("%d", &n);

    for (int i=1;i<=n;i++){
        scanf ("%d", &amount);
        total = total + amount;
    } 
    
    if(total>10000){
        printf("limit exceeded");
    }
    else{
        printf("approved");
    }
    
    
    return 0;
}
