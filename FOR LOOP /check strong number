#include <stdio.h>

int main()
{
    int number, temp, digit;
    int sum = 0;
    int factorial;

    printf("Enter a number: ");
    scanf("%d", &number);

    temp = number;

     for (int i = 1; i <= digit; i++)
        {
            factorial = factorial * i;
        }

        sum = sum + factorial;
    }

    if (sum == number)
        printf("%d is a Strong Number", number);
    else
        printf("%d is not a Strong Number", number);

    return 0;
}
