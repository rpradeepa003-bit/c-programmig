#include <stdio.h>

int main()
{
    int N, loss, totalLoss = 0, highLossDays = 0;

    printf("Enter number of days: ");
    scanf("%d", &N);

    printf("Enter daily losses:\n");

    for (int i = 1; i <= N; i++){
        scanf("%d", &loss);

        totalLoss = totalLoss + loss;

        if (loss > 100)  {
            highLossDays++;
        }
    }

    printf("Total Loss: %d\n", totalLoss);
    printf("High Loss Days: %d\n", highLossDays);

    return 0;
}
