#include <stdio.h>

int main() {
    int N, usage, total = 0, highusageDays = 0;

    scanf("%d", &N);

    for(int i = 1; i <= N; i++) {
        scanf("%d", &usage);

        total = total + usage;

        if(usage > 2) {
            highusageDays++;
        }
    }
    printf("Total Data: %d\n", total);
    printf("High Usage Days: %d\n", highusageDays);

    return 0;
}
