#include <stdio.h>
int main(){
    int num1,num2,i,gcd,min;

    printf("enter two number :");
    scanf("%d %d", &num1,&num2);

    if (num1<num2){
        min=num1;
    }
    else{
        min=num2;
    }
    for (int i=1;i<=min;i++){
        if (num1% i ==0 && num2 % i ==0)
            gcd = i;
    }

    printf ("GCD = %d ", gcd);

    int lcm=(num1*num2)/gcd;

    printf ("lcm=%d ", lcm);
    
    return 0;
}
