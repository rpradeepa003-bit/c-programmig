#include <stdio.h>

int main() {
    int n, original, remainder;
    int sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    original = n;

    for (; n != 0; n = n / 10) {
        remainder = n % 10;
        sum = sum + (remainder * remainder * remainder);
    }

    if (sum == original)
        printf("Yes");
    else
        printf("No");

    return 0;
}
