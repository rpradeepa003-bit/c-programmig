#include <stdio.h>

int main() {
    int i, n, count = 0; 

    printf("enter the number:");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        if (n % i == 0) {
            count++; 
        }
    }

    if (count == 2) {
        printf("prime\n");
    } else {
        printf("not prime\n");
    }

    return 0;
}
